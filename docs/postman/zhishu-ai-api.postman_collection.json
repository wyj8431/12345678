{
  "info": {
    "name": "Zhishu AI API",
    "description": "Postman collection for the Zhishu AI knowledge-base QA backend. Default mode is mock-first at http://127.0.0.1:3001.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "assistantMessageId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
